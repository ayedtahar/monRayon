# Clé serveur, jamais exposée au navigateur
OPENAI_API_KEY=

# Modèle vision modifiable sans changer le code
OPENAI_VISION_MODEL=gpt-4.1-mini

# Optionnel : utile pour pointer vers l'environnement de test Open Food Facts
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org

# Open Food Facts demande un contact identifiable dans le User-Agent
OPEN_FOOD_FACTS_CONTACT=

# Limitation de débit par client, en fenêtre glissante
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SECONDS=300

# Plafond d'analyses réelles sur 24 h glissantes : borne la facture vision
DAILY_ANALYSIS_BUDGET=200
